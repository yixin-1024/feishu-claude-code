# 注意：systemd EnvironmentFile 不支持行尾注释，注释一律单独成行
# cc-lark web gateway 配置（真文件放 ~/.config/cc-lark-web.env，chmod 600，不进 git）
# token：python3 -c "import secrets; print(secrets.token_urlsafe(32))"；没配 / 少于 32 字符 → 所有接口 503
CC_WEB_GATEWAY_TOKEN=
# 只允许回环地址
CC_WEB_GATEWAY_HOST=127.0.0.1
CC_WEB_GATEWAY_PORT=8096
CC_WEB_STATE_DIR=/home/yixin/.local/state/cc-lark-web
# 同时在跑的 claude 进程上限，超出排队
CC_WEB_MAX_CONCURRENT=3
# 排队上限，超出 429
CC_WEB_MAX_QUEUE=20
# 无输出且无子进程多久就杀
CC_WEB_IDLE_TIMEOUT_SEC=300
# 单轮墙钟上限（0 = 不限）
CC_WEB_WALL_CLOCK_SEC=900
# CC_WEB_STUCK_CHILD_TIMEOUT_SEC=900   # 有子进程但无输出的上限，默认 = 墙钟
# CC_WEB_RETENTION_DAYS=14             # runs/ 下事件文件保留天数
# CC_WEB_CLAUDE_CLI=/usr/bin/claude
CC_WEB_DEFAULT_MODEL=sonnet
CC_WEB_DEFAULT_EFFORT=medium

# 允许的应用（逗号分隔）；每个应用一组 CC_WEB_APP_<NAME>_*（名字转大写、- 换成 _）
CC_WEB_APPS=rg-next
# 只来自配置，请求改不了
CC_WEB_APP_RG_NEXT_CWD=/home/yixin/workspace/spxpay/rg-next/agent
CC_WEB_APP_RG_NEXT_MODEL=sonnet
# 请求 model 字段的白名单
CC_WEB_APP_RG_NEXT_MODELS=sonnet,opus,haiku
CC_WEB_APP_RG_NEXT_EFFORT=medium
# 带括号的值要加引号（shell source 时才不报错；systemd 会去掉引号）。Edit/Write/Task 等写入类工具配了会拒绝启动
CC_WEB_APP_RG_NEXT_ALLOWED_TOOLS="Bash(rg-tool:*),Read,Grep,Glob,WebSearch,WebFetch"
# bypassPermissions/acceptEdits/auto 会拒绝启动
CC_WEB_APP_RG_NEXT_PERMISSION_MODE=dontAsk
# 请求 env 只能带这些键
CC_WEB_APP_RG_NEXT_ENV_KEYS=RG_RUN_TOKEN,RG_API_BASE,RG_LOCALE
# CC_WEB_APP_RG_NEXT_PATH_PREPEND=/home/yixin/workspace/spxpay/rg-next/agent/bin   # 默认 <cwd>/bin
# CC_WEB_APP_RG_NEXT_SYSTEM_PROMPT_FILE=   # 默认 <cwd>/CLAUDE.md（--restricted 下不会自动加载，网关显式挂上）
