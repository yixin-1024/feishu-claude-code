#!/usr/bin/env bash
# cc-lark — 飞书/Lark Claude Bot 服务控制（macOS launchd KeepAlive）
# supervisor = 持久化 LaunchAgent `cc-lark-main`（~/Library/LaunchAgents/cc-lark-main.plist）：
# RunAtLoad + KeepAlive 跑 .app wrapper（wrapper 负责起 ngrok + main.py），
# 崩溃/OOM/外部 SIGTERM 任何死法都在 ~10s 内自动重拉；/restart 走
# `launchctl kickstart -k`。不再用「登录项 + open」——二者并存会双启动抢 9981。

set -euo pipefail

APP_NAME="cc-lark"
APP_PATH="/Applications/${APP_NAME}.app"
BUNDLE_ID="com.cc-lark.bot.app"
WRAPPER_PATH="${APP_PATH}/Contents/MacOS/${APP_NAME}"
INFO_PLIST="${APP_PATH}/Contents/Info.plist"

LOG_DIR="$HOME/.feishu-claude"
LOG_FILE="$LOG_DIR/cc-lark.log"
NGROK_LOG="$LOG_DIR/cc-lark-ngrok.log"

# launchd supervisor（持久化 LaunchAgent，落盘 plist，重启机器/注销都在）
LAUNCHD_LABEL="cc-lark-main"
PLIST_PATH="$HOME/Library/LaunchAgents/${LAUNCHD_LABEL}.plist"
GUI_DOMAIN="gui/$(id -u)"
SERVICE_TARGET="${GUI_DOMAIN}/${LAUNCHD_LABEL}"

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
SCRIPT_PATH="$REPO_ROOT/deploy/cc-lark"
ENV_FILE="$REPO_ROOT/.env"

# ── 进程探测 ──────────────────────────────────────────────────────────────

_wrapper_pid() {
    # 兼容两种 .app 布局：
    #   - cc-lark install 生成的：bash 直接是 Contents/MacOS/cc-lark
    #   - Mach-O launcher（如 Platypus）：MacOS/cc-lark 是二进制，bash 跑
    #     Contents/Resources/script
    # 用任意 bash + .app 路径前缀都能命中，不会误杀别的 cc-lark。
    pgrep -f "^/bin/bash ${APP_PATH}/" 2>/dev/null | head -1
}
_is_running() { [[ -n "$(_wrapper_pid)" ]]; }

_ngrok_pid() {
    # ngrok 由 wrapper 启，但有时会孤立到 PPID 1（之前 wrapper 异常退过又重启）
    # ——按命令行直接找，不强求父进程关系。
    pgrep -f '^ngrok http' 2>/dev/null | head -1
}

_print_ws_info() {
    [[ -f "$LOG_FILE" ]] || return
    local rows last_conn last_attempt
    rows="$(tail -n 5000 "$LOG_FILE" 2>/dev/null \
        | grep -E '\[Lark\] \[[^]]+\] \[(INFO|ERROR)\] (connected to wss://|trying to reconnect|connect failed)' \
        || true)"
    [[ -z "$rows" ]] && { printf "  %-12s %s\n" "WS 状态" "（log 中无 Lark WS 记录）"; return; }

    last_conn="$(printf '%s\n' "$rows"    | grep 'connected to wss://' | tail -1)"
    last_attempt="$(printf '%s\n' "$rows" | grep -E '(trying to reconnect|connect failed)' | tail -1)"

    if [[ -n "$last_conn" ]]; then
        local ts host
        ts="$(printf '%s' "$last_conn"   | sed -E 's/.*\[Lark\] \[([^]]+)\].*/\1/')"
        host="$(printf '%s' "$last_conn" | sed -E 's|.*connected to wss://([^/?]+).*|\1|')"
        printf "  %-12s %s  (%s)\n" "WS 上次连上" "$ts" "$host"
    else
        printf "  %-12s %s\n" "WS 上次连上" "（最近 5000 行 log 里没看到 connected）"
    fi

    if [[ -n "$last_attempt" && -n "$last_conn" ]]; then
        local att_ts conn_ts
        att_ts="$(printf '%s'  "$last_attempt" | sed -E 's/.*\[Lark\] \[([^]]+)\].*/\1/')"
        conn_ts="$(printf '%s' "$last_conn"    | sed -E 's/.*\[Lark\] \[([^]]+)\].*/\1/')"
        # 时间戳是 YYYY-MM-DD HH:MM:SS,fff，字典序 = 时序
        if [[ "$att_ts" > "$conn_ts" ]]; then
            printf "  %-12s ⚠️  %s 之后仍在重连\n" "" "$att_ts"
        fi
    fi
}

_login_items_has() {
    osascript -e "tell application \"System Events\" to (login item \"${APP_NAME}\" exists)" 2>/dev/null \
        | grep -q "true"
}

# 若历史遗留了 cc-lark 登录项，清掉——launchd RunAtLoad 已接管开机启动，
# 二者并存会在登录时双启动抢 9981。
_remove_login_item_if_any() {
    if _login_items_has; then
        osascript -e "tell application \"System Events\" to delete login item \"${APP_NAME}\"" >/dev/null 2>&1 \
            && echo "🧹 已移除遗留登录项（launchd 已接管开机启动）"
    fi
}

# ── launchd supervisor ───────────────────────────────────────────────────

_launchd_loaded() { launchctl print "$SERVICE_TARGET" >/dev/null 2>&1; }

_write_plist() {
    mkdir -p "$(dirname "$PLIST_PATH")" "$LOG_DIR"
    # KeepAlive=true（无条件）：wrapper 收 SIGTERM 后 trap exit 0，用
    # SuccessfulExit=false 崩溃后不会重拉；故无条件保活，有意重启交给 kickstart -k。
    cat > "$PLIST_PATH" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${LAUNCHD_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${WRAPPER_PATH}</string>
    </array>
    <key>WorkingDirectory</key>
    <string>${REPO_ROOT}</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>${LOG_DIR}/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>${LOG_DIR}/launchd.err.log</string>
</dict>
</plist>
PLIST_EOF
    echo "📝 已写 launchd plist: $PLIST_PATH"
}

# 重新载入 plist（先 bootout 再 bootstrap，幂等）
_launchd_reload() {
    launchctl bootout "$SERVICE_TARGET" 2>/dev/null || true
    launchctl bootstrap "$GUI_DOMAIN" "$PLIST_PATH" 2>&1
}

# ── .app 生成 ────────────────────────────────────────────────────────────

_resolve_python() {
    local p="${PYTHON_BIN:-$(command -v python3 || true)}"
    if [[ -z "$p" ]]; then
        echo "❌ 找不到 python3（用 PYTHON_BIN=/path/to/python3 覆盖）" >&2
        exit 1
    fi
    # pyenv shim 是 bash 脚本，TCC 跟踪 exec 后的真实解释器——这里直接解析掉，
    # 让 wrapper 直接调真二进制，进程链更干净。
    if [[ "$p" == *"/.pyenv/shims/"* ]]; then
        local resolved
        resolved="$($p -c 'import sys; print(sys.executable)' 2>/dev/null || true)"
        [[ -n "$resolved" && -x "$resolved" ]] && p="$resolved"
    fi
    echo "$p"
}

_write_wrapper() {
    local python_bin ngrok_bin claude_bin extra_path
    python_bin="$(_resolve_python)"
    ngrok_bin="$(command -v ngrok || true)"
    claude_bin="$(command -v claude || true)"

    extra_path=""
    [[ -n "$claude_bin" ]] && extra_path="$(dirname "$claude_bin"):${extra_path}"
    [[ -n "$ngrok_bin"  ]] && extra_path="$(dirname "$ngrok_bin"):${extra_path}"

    mkdir -p "$APP_PATH/Contents/MacOS" "$APP_PATH/Contents/Resources"

    # 字面量模板（quoted heredoc 防止变量在生成时展开）
    cat > "$WRAPPER_PATH" <<'WRAPPER_EOF'
#!/usr/bin/env bash
# cc-lark.app 启动器 — 由 `cc-lark install` 生成；手改请同步改 deploy/cc-lark
set -uo pipefail

REPO_ROOT="__REPO_ROOT__"
PYTHON_BIN="__PYTHON_BIN__"
NGROK_BIN="__NGROK_BIN__"

LOG_DIR="$HOME/.feishu-claude"
mkdir -p "$LOG_DIR"
BOT_LOG="$LOG_DIR/cc-lark.log"
NGROK_LOG="$LOG_DIR/cc-lark-ngrok.log"
ENV_FILE="$REPO_ROOT/.env"

CALLBACK_PORT="9981"
NGROK_DOMAIN=""
if [[ -f "$ENV_FILE" ]]; then
    while IFS='=' read -r key val; do
        val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
        case "$key" in
            CALLBACK_PORT) [[ -n "$val" ]] && CALLBACK_PORT="$val" ;;
            NGROK_DOMAIN)  NGROK_DOMAIN="$val" ;;
        esac
    done < <(grep -E "^(CALLBACK_PORT|NGROK_DOMAIN)=" "$ENV_FILE")
fi

export PATH="__EXTRA_PATH__/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
export HOME="__HOME_DIR__"

cd "$REPO_ROOT" || { echo "[$(date)] cd $REPO_ROOT failed" >>"$BOT_LOG"; exit 1; }

ngrok_pid=""; bot_pid=""
cleanup() {
    [[ -n "$bot_pid"   ]] && kill "$bot_pid"   2>/dev/null || true
    [[ -n "$ngrok_pid" ]] && kill "$ngrok_pid" 2>/dev/null || true
    wait 2>/dev/null
    echo "[$(date)] cc-lark.app stopped" >>"$BOT_LOG"
    exit 0
}
trap cleanup INT TERM

echo "[$(date)] cc-lark.app starting (PID $$)" >>"$BOT_LOG"

if [[ -n "$NGROK_BIN" && -x "$NGROK_BIN" ]]; then
    if [[ -n "$NGROK_DOMAIN" ]]; then
        "$NGROK_BIN" http --url "$NGROK_DOMAIN" "$CALLBACK_PORT" >>"$NGROK_LOG" 2>&1 &
    else
        "$NGROK_BIN" http "$CALLBACK_PORT" >>"$NGROK_LOG" 2>&1 &
    fi
    ngrok_pid=$!
    sleep 2
fi

"$PYTHON_BIN" main.py >>"$BOT_LOG" 2>&1 &
bot_pid=$!
wait "$bot_pid"
cleanup
WRAPPER_EOF

    # 占位符替换。用 | 作分隔符避免路径里的 / 冲突。
    sed -i.bak \
        -e "s|__REPO_ROOT__|${REPO_ROOT}|g" \
        -e "s|__PYTHON_BIN__|${python_bin}|g" \
        -e "s|__NGROK_BIN__|${ngrok_bin}|g" \
        -e "s|__EXTRA_PATH__|${extra_path}|g" \
        -e "s|__HOME_DIR__|${HOME}|g" \
        "$WRAPPER_PATH"
    rm -f "$WRAPPER_PATH.bak"
    chmod +x "$WRAPPER_PATH"

    echo "📝 wrapper : $WRAPPER_PATH"
    echo "   python  : $python_bin"
    echo "   ngrok   : ${ngrok_bin:-（未装，跳过 ngrok）}"
    echo "   claude  : ${claude_bin:-（未找到，bot 可能报错）}"
}

_write_info_plist() {
    cat > "$INFO_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>${APP_NAME}</string>
    <key>CFBundleIdentifier</key><string>${BUNDLE_ID}</string>
    <key>CFBundleName</key><string>${APP_NAME}</string>
    <key>CFBundleDisplayName</key><string>${APP_NAME}</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.0.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>LSUIElement</key><true/>
    <key>LSMinimumSystemVersion</key><string>11.0</string>
    <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
EOF
}

_codesign() {
    codesign --force --deep --sign - "$APP_PATH" >/dev/null 2>&1 || true
}

_try_symlink() {
    local candidates=(/opt/homebrew/bin /usr/local/bin "$HOME/.local/bin")
    for dir in "${candidates[@]}"; do
        if [[ -d "$dir" && -w "$dir" ]]; then
            ln -sf "$SCRIPT_PATH" "$dir/cc-lark"
            return 0
        fi
    done
    return 1
}

# ── 命令 ─────────────────────────────────────────────────────────────────

cmd_install() {
    # --no-login-item 保留为兼容旧调用的 no-op（launchd 形态下没有登录项概念）
    [[ "${1:-}" == "--no-login-item" ]] && shift || true

    echo "📦 (重新)生成 $APP_PATH"
    _write_wrapper
    _write_info_plist
    _codesign
    _try_symlink || true

    # launchd 接管：写 plist + (重)载入。清掉任何遗留登录项防双实例。
    _remove_login_item_if_any
    _write_plist
    echo "🚀 载入 launchd 服务 ($LAUNCHD_LABEL)"
    _launchd_reload
    sleep 2
    if _is_running; then
        echo "✅ 已安装并启动（wrapper PID $(_wrapper_pid)）— 崩溃/重启机器都自动拉起"
    else
        echo "⚠️  已安装但未见 wrapper 进程，看日志: tail -n 50 $LOG_FILE" >&2
    fi
}

cmd_uninstall() {
    if _launchd_loaded; then
        launchctl bootout "$SERVICE_TARGET" 2>/dev/null || true
        echo "🗑  已 bootout launchd 服务"
    fi
    [[ -f "$PLIST_PATH" ]] && rm -f "$PLIST_PATH" && echo "🗑  已删除 plist"
    _remove_login_item_if_any
    if [[ -d "$APP_PATH" ]]; then
        rm -rf "$APP_PATH"
        echo "🗑  已删除 $APP_PATH"
    fi
    for dir in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
        [[ -L "$dir/cc-lark" ]] && rm -f "$dir/cc-lark"
    done
    echo "✅ 已卸载（launchd + .app + symlink）"
}

cmd_start() {
    if [[ ! -f "$PLIST_PATH" ]]; then
        echo "❌ 未安装 launchd 服务：$PLIST_PATH 不存在；先 cc-lark install" >&2
        exit 1
    fi
    if _is_running; then
        echo "ℹ️  已经在跑（wrapper PID $(_wrapper_pid)）"
        return 0
    fi
    _launchd_loaded || _launchd_reload >/dev/null 2>&1
    launchctl kickstart "$SERVICE_TARGET" 2>/dev/null || true
    sleep 2
    if _is_running; then
        echo "✅ 已启动（wrapper PID $(_wrapper_pid)）"
    else
        echo "❌ 启动失败，看日志: tail -n 50 $LOG_FILE" >&2
        exit 1
    fi
}

cmd_stop() {
    # 停服 = 关掉 KeepAlive（bootout），否则 kill 后 launchd 立刻重拉。
    if ! _launchd_loaded && ! _is_running; then
        echo "ℹ️  本来就没在跑"
        return 0
    fi
    launchctl bootout "$SERVICE_TARGET" 2>/dev/null || true
    local i
    for i in 1 2 3 4 5 6 7 8; do
        sleep 1
        _is_running || break
    done
    if _is_running; then
        echo "⚠️  bootout 后仍在跑，强杀 wrapper"
        kill -KILL "$(_wrapper_pid)" 2>/dev/null || true
        sleep 1
    fi
    # 兜底：万一 trap cleanup 没跑到，把 ngrok 也清掉
    pgrep -f '^ngrok http' >/dev/null 2>&1 && pkill -f '^ngrok http' || true
    echo "⏹  已停止（launchd 服务已 bootout；cc-lark start 重新拉起）"
}

cmd_restart() {
    # 有意重启：kickstart -k 原子杀+拉（KeepAlive 全程在，不经历「停服」窗口）
    if ! _launchd_loaded; then
        echo "ℹ️  launchd 服务未载入，走 start"
        cmd_start
        return
    fi
    launchctl kickstart -k "$SERVICE_TARGET" 2>&1 || true
    sleep 2
    if _is_running; then
        echo "♻️  已重启（wrapper PID $(_wrapper_pid)）"
    else
        echo "⚠️  重启后未见 wrapper，看日志: tail -n 50 $LOG_FILE" >&2
    fi
}

cmd_status() {
    if [[ ! -d "$APP_PATH" ]]; then
        echo "📊 未安装（cc-lark install）"
        return 1
    fi
    echo "📊 cc-lark 状态"

    if _is_running; then
        local wpid bpid npid
        wpid="$(_wrapper_pid)"
        bpid="$(pgrep -P "$wpid" -f main.py 2>/dev/null || true)"
        # bot 也可能不是 wrapper 的直接子（重启后只换了 python，bash 仍是老 PID）
        # ——直接按命令行兜底。
        [[ -z "$bpid" ]] && bpid="$(pgrep -f 'python.* main\.py$' 2>/dev/null | head -1)"
        npid="$(_ngrok_pid)"
        printf "  %-12s %s\n" "wrapper"  "运行中 (PID $wpid)"
        printf "  %-12s %s\n" "bot"      "${bpid:-未启动}"
        printf "  %-12s %s\n" "ngrok"    "${npid:-未启动}"
    else
        printf "  %-12s %s\n" "wrapper"  "未运行"
    fi

    if _launchd_loaded; then
        printf "  %-12s %s\n" "launchd"  "已载入（$LAUNCHD_LABEL，KeepAlive）"
    else
        printf "  %-12s %s\n" "launchd"  "未载入（cc-lark install 会写 plist 并载入）"
    fi
    if _login_items_has; then
        printf "  %-12s %s\n" "⚠️ 登录项" "仍存在（应移除，与 launchd 双启动抢端口）"
    fi

    _print_ws_info

    echo ""
    echo "  bot   日志: $LOG_FILE"
    echo "  ngrok 日志: $NGROK_LOG"
    if [[ -f "$LOG_FILE" ]]; then
        echo ""
        echo "── bot 最近 10 行 ──"
        tail -n 10 "$LOG_FILE"
    fi
}

cmd_logs() {
    local follow=false n=50 target="bot"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--follow) follow=true; shift ;;
            -n) n="$2"; shift 2 ;;
            -n*) n="${1#-n}"; shift ;;
            bot|ngrok) target="$1"; shift ;;
            *) shift ;;
        esac
    done
    local f="$LOG_FILE"
    [[ "$target" == "ngrok" ]] && f="$NGROK_LOG"
    if [[ ! -f "$f" ]]; then
        echo "❌ 日志文件不存在: $f" >&2
        exit 1
    fi
    if $follow; then tail -n "$n" -f "$f"; else tail -n "$n" "$f"; fi
}

usage() {
    cat <<EOF
cc-lark — 飞书/Lark Claude Bot 服务控制（macOS launchd KeepAlive）

用法:
  cc-lark install                     生成 .app wrapper + 写 launchd plist 并载入（崩溃自动拉起）
  cc-lark uninstall                   卸载 (launchd + .app + symlink)
  cc-lark start                       启动（launchctl kickstart）
  cc-lark stop                        停止（launchctl bootout，关掉 KeepAlive）
  cc-lark restart                     重启（launchctl kickstart -k，原子杀+拉）
  cc-lark status                      运行状态 + launchd + WS + bot 日志末尾
  cc-lark logs [bot|ngrok] [-n N] [-f]  查看日志

文件:
  .app        : ${APP_PATH}
  wrapper     : ${WRAPPER_PATH}
  launchd     : ${PLIST_PATH}  (label ${LAUNCHD_LABEL})
  bot   日志  : ${LOG_FILE}
  ngrok 日志  : ${NGROK_LOG}

.env 可配置:
  CALLBACK_PORT   卡片回调端口（默认 9981）
  NGROK_DOMAIN    ngrok 固定域名（不设置则随机域名）

环境变量:
  PYTHON_BIN      覆盖 python3 路径（默认 \$(command -v python3)，pyenv shim 会自动解析为真实解释器）
EOF
}

case "${1:-}" in
    install|uninstall|start|stop|restart|status|logs)
        cmd="cmd_${1}"; shift
        "$cmd" "$@"
        ;;
    ""|-h|--help|help) usage ;;
    *) echo "❌ 未知命令: $1" >&2; usage; exit 1 ;;
esac
