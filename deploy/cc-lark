#!/usr/bin/env bash
# cc-lark — 飞书/Lark Claude Bot 服务控制（macOS .app + 登录项）
# 早期版本用 launchd LaunchAgent。launchd 启动的进程，TCC 责任方 = launchd，
# 导致 main.py 子进程链里的 peekaboo 拿不到「辅助功能 / 屏幕录制」等 GUI 权限。
# 现在改成把 main.py + ngrok 放在 /Applications/cc-lark.app 里跑，
# 责任方变成 cc-lark.app（com.cc-lark.bot.app），授权链能落到 peekaboo。

set -euo pipefail

APP_NAME="cc-lark"
APP_PATH="/Applications/${APP_NAME}.app"
BUNDLE_ID="com.cc-lark.bot.app"
WRAPPER_PATH="${APP_PATH}/Contents/MacOS/${APP_NAME}"
INFO_PLIST="${APP_PATH}/Contents/Info.plist"

LOG_DIR="$HOME/.feishu-claude"
LOG_FILE="$LOG_DIR/cc-lark.log"
NGROK_LOG="$LOG_DIR/cc-lark-ngrok.log"

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
SCRIPT_PATH="$REPO_ROOT/deploy/cc-lark"
ENV_FILE="$REPO_ROOT/.env"

TCC_DB="/Library/Application Support/com.apple.TCC/TCC.db"

# ── 进程探测 ──────────────────────────────────────────────────────────────

_wrapper_pid() {
    # 只匹配 .app 里的 wrapper，避免误杀别的 cc-lark
    pgrep -f "^bash ${WRAPPER_PATH}$" 2>/dev/null | head -1
}
_is_running() { [[ -n "$(_wrapper_pid)" ]]; }

_login_items_has() {
    osascript -e "tell application \"System Events\" to (login item \"${APP_NAME}\" exists)" 2>/dev/null \
        | grep -q "true"
}

# ── .app 生成 ────────────────────────────────────────────────────────────

_resolve_python() {
    local p="${PYTHON_BIN:-$(command -v python3 || true)}"
    if [[ -z "$p" ]]; then
        echo "❌ 找不到 python3（用 PYTHON_BIN=/path/to/python3 覆盖）" >&2
        exit 1
    fi
    # pyenv shim 是 bash 脚本，TCC 跟踪 exec 后的真实解释器——这里直接解析掉，
    # 让 wrapper 直接调真二进制，进程链更干净。
    if [[ "$p" == *"/.pyenv/shims/"* ]]; then
        local resolved
        resolved="$($p -c 'import sys; print(sys.executable)' 2>/dev/null || true)"
        [[ -n "$resolved" && -x "$resolved" ]] && p="$resolved"
    fi
    echo "$p"
}

_write_wrapper() {
    local python_bin ngrok_bin claude_bin extra_path
    python_bin="$(_resolve_python)"
    ngrok_bin="$(command -v ngrok || true)"
    claude_bin="$(command -v claude || true)"

    extra_path=""
    [[ -n "$claude_bin" ]] && extra_path="$(dirname "$claude_bin"):${extra_path}"
    [[ -n "$ngrok_bin"  ]] && extra_path="$(dirname "$ngrok_bin"):${extra_path}"

    mkdir -p "$APP_PATH/Contents/MacOS" "$APP_PATH/Contents/Resources"

    # 字面量模板（quoted heredoc 防止变量在生成时展开）
    cat > "$WRAPPER_PATH" <<'WRAPPER_EOF'
#!/usr/bin/env bash
# cc-lark.app 启动器 — 由 `cc-lark install` 生成；手改请同步改 deploy/cc-lark
set -uo pipefail

REPO_ROOT="__REPO_ROOT__"
PYTHON_BIN="__PYTHON_BIN__"
NGROK_BIN="__NGROK_BIN__"

LOG_DIR="$HOME/.feishu-claude"
mkdir -p "$LOG_DIR"
BOT_LOG="$LOG_DIR/cc-lark.log"
NGROK_LOG="$LOG_DIR/cc-lark-ngrok.log"
ENV_FILE="$REPO_ROOT/.env"

CALLBACK_PORT="9981"
NGROK_DOMAIN=""
if [[ -f "$ENV_FILE" ]]; then
    while IFS='=' read -r key val; do
        val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
        case "$key" in
            CALLBACK_PORT) [[ -n "$val" ]] && CALLBACK_PORT="$val" ;;
            NGROK_DOMAIN)  NGROK_DOMAIN="$val" ;;
        esac
    done < <(grep -E "^(CALLBACK_PORT|NGROK_DOMAIN)=" "$ENV_FILE")
fi

export PATH="__EXTRA_PATH__/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
export HOME="__HOME_DIR__"

cd "$REPO_ROOT" || { echo "[$(date)] cd $REPO_ROOT failed" >>"$BOT_LOG"; exit 1; }

ngrok_pid=""; bot_pid=""
cleanup() {
    [[ -n "$bot_pid"   ]] && kill "$bot_pid"   2>/dev/null || true
    [[ -n "$ngrok_pid" ]] && kill "$ngrok_pid" 2>/dev/null || true
    wait 2>/dev/null
    echo "[$(date)] cc-lark.app stopped" >>"$BOT_LOG"
    exit 0
}
trap cleanup INT TERM

echo "[$(date)] cc-lark.app starting (PID $$)" >>"$BOT_LOG"

if [[ -n "$NGROK_BIN" && -x "$NGROK_BIN" ]]; then
    if [[ -n "$NGROK_DOMAIN" ]]; then
        "$NGROK_BIN" http --url "$NGROK_DOMAIN" "$CALLBACK_PORT" >>"$NGROK_LOG" 2>&1 &
    else
        "$NGROK_BIN" http "$CALLBACK_PORT" >>"$NGROK_LOG" 2>&1 &
    fi
    ngrok_pid=$!
    sleep 2
fi

"$PYTHON_BIN" main.py >>"$BOT_LOG" 2>&1 &
bot_pid=$!
wait "$bot_pid"
cleanup
WRAPPER_EOF

    # 占位符替换。用 | 作分隔符避免路径里的 / 冲突。
    sed -i.bak \
        -e "s|__REPO_ROOT__|${REPO_ROOT}|g" \
        -e "s|__PYTHON_BIN__|${python_bin}|g" \
        -e "s|__NGROK_BIN__|${ngrok_bin}|g" \
        -e "s|__EXTRA_PATH__|${extra_path}|g" \
        -e "s|__HOME_DIR__|${HOME}|g" \
        "$WRAPPER_PATH"
    rm -f "$WRAPPER_PATH.bak"
    chmod +x "$WRAPPER_PATH"

    echo "📝 wrapper : $WRAPPER_PATH"
    echo "   python  : $python_bin"
    echo "   ngrok   : ${ngrok_bin:-（未装，跳过 ngrok）}"
    echo "   claude  : ${claude_bin:-（未找到，bot 可能报错）}"
}

_write_info_plist() {
    cat > "$INFO_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>${APP_NAME}</string>
    <key>CFBundleIdentifier</key><string>${BUNDLE_ID}</string>
    <key>CFBundleName</key><string>${APP_NAME}</string>
    <key>CFBundleDisplayName</key><string>${APP_NAME}</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.0.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>LSUIElement</key><true/>
    <key>LSMinimumSystemVersion</key><string>11.0</string>
    <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
EOF
}

_codesign() {
    codesign --force --deep --sign - "$APP_PATH" >/dev/null 2>&1 || true
}

_try_symlink() {
    local candidates=(/opt/homebrew/bin /usr/local/bin "$HOME/.local/bin")
    for dir in "${candidates[@]}"; do
        if [[ -d "$dir" && -w "$dir" ]]; then
            ln -sf "$SCRIPT_PATH" "$dir/cc-lark"
            return 0
        fi
    done
    return 1
}

# ── 命令 ─────────────────────────────────────────────────────────────────

cmd_install() {
    local add_login=true
    [[ "${1:-}" == "--no-login-item" ]] && add_login=false

    local was_running=false
    _is_running && was_running=true

    echo "📦 (重新)生成 $APP_PATH"
    _write_wrapper
    _write_info_plist
    _codesign
    _try_symlink || true

    if $add_login; then
        if _login_items_has; then
            echo "✅ 登录项已存在"
        else
            osascript -e "tell application \"System Events\" to make login item at end with properties {path:\"${APP_PATH}\", hidden:false}" >/dev/null
            echo "✅ 已加入登录项"
        fi
    fi

    echo ""
    if $was_running; then
        echo "⚠️  当前有实例在跑（用旧 wrapper）"
        echo "   要应用新 wrapper：cc-lark restart"
        echo "   ⚠️  签名 cdhash 变了，TCC 授权可能失效；若 peekaboo 报权限错，"
        echo "       去「系统设置 → 隐私与安全性」把 cc-lark 从相关权限移除再重新加。"
    else
        echo "下一步: cc-lark start"
    fi
}

cmd_uninstall() {
    cmd_stop >/dev/null 2>&1 || true
    if _login_items_has; then
        osascript -e "tell application \"System Events\" to delete login item \"${APP_NAME}\"" >/dev/null
        echo "🗑  已从登录项移除"
    fi
    if [[ -d "$APP_PATH" ]]; then
        rm -rf "$APP_PATH"
        echo "🗑  已删除 $APP_PATH"
    fi
    for dir in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
        [[ -L "$dir/cc-lark" ]] && rm -f "$dir/cc-lark"
    done
    echo "✅ 已卸载（.app + 登录项 + symlink）"
    echo "ℹ️  TCC 授权（辅助功能/屏幕录制/完全磁盘访问）需要你手动去系统设置里删，"
    echo "    否则留下灰条目；下次同 bundle id 重装可能直接复用旧授权（也可能失效）。"
}

cmd_start() {
    if [[ ! -d "$APP_PATH" ]]; then
        echo "❌ 未安装：$APP_PATH 不存在；先 cc-lark install" >&2
        exit 1
    fi
    if _is_running; then
        echo "ℹ️  已经在跑（PID $(_wrapper_pid)）"
        return 0
    fi
    open "$APP_PATH"
    sleep 2
    if _is_running; then
        echo "✅ 已启动（PID $(_wrapper_pid)）"
    else
        echo "❌ 启动失败，看日志: tail -n 50 $LOG_FILE" >&2
        exit 1
    fi
}

cmd_stop() {
    local pid
    pid="$(_wrapper_pid)"
    if [[ -z "$pid" ]]; then
        echo "ℹ️  本来就没在跑"
        return 0
    fi
    kill -TERM "$pid" 2>/dev/null || true
    local i
    for i in 1 2 3 4 5 6 7 8; do
        sleep 1
        _is_running || break
    done
    if _is_running; then
        echo "⚠️  TERM 无效，强杀"
        kill -KILL "$(_wrapper_pid)" 2>/dev/null || true
        sleep 1
    fi
    # 兜底：万一 trap cleanup 没跑到，把 ngrok 也清掉
    pgrep -f "ngrok http.*${BUNDLE_ID%.*}" >/dev/null 2>&1 && pkill -f "ngrok http.*${BUNDLE_ID%.*}" || true
    echo "⏹  已停止"
}

cmd_restart() {
    cmd_stop || true
    sleep 1
    cmd_start
}

cmd_status() {
    if [[ ! -d "$APP_PATH" ]]; then
        echo "📊 未安装（cc-lark install）"
        return 1
    fi
    echo "📊 cc-lark 状态"

    if _is_running; then
        local wpid bpid npid
        wpid="$(_wrapper_pid)"
        bpid="$(pgrep -P "$wpid" -f main.py 2>/dev/null || true)"
        npid="$(pgrep -P "$wpid" -f ngrok    2>/dev/null || true)"
        printf "  %-12s %s\n" "wrapper"  "运行中 (PID $wpid)"
        printf "  %-12s %s\n" "bot"      "${bpid:-未启动}"
        printf "  %-12s %s\n" "ngrok"    "${npid:-未启动}"
    else
        printf "  %-12s %s\n" "wrapper"  "未运行"
    fi

    if _login_items_has; then
        printf "  %-12s %s\n" "登录项"   "已加入"
    else
        printf "  %-12s %s\n" "登录项"   "未加入（cc-lark install 会自动加）"
    fi

    if [[ -r "$TCC_DB" ]]; then
        local granted
        granted="$(sqlite3 "$TCC_DB" \
            "SELECT service FROM access WHERE client='${BUNDLE_ID}' AND auth_value=2;" 2>/dev/null \
            | sed -e 's/kTCCService//' | tr '\n' ' ')"
        if [[ -n "$granted" ]]; then
            printf "  %-12s %s\n" "TCC 授权" "$granted"
        else
            printf "  %-12s %s\n" "TCC 授权" "（无；首次使用 peekaboo 时去系统设置加）"
        fi
    fi

    echo ""
    echo "  bot   日志: $LOG_FILE"
    echo "  ngrok 日志: $NGROK_LOG"
    if [[ -f "$LOG_FILE" ]]; then
        echo ""
        echo "── bot 最近 10 行 ──"
        tail -n 10 "$LOG_FILE"
    fi
}

cmd_logs() {
    local follow=false n=50 target="bot"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--follow) follow=true; shift ;;
            -n) n="$2"; shift 2 ;;
            -n*) n="${1#-n}"; shift ;;
            bot|ngrok) target="$1"; shift ;;
            *) shift ;;
        esac
    done
    local f="$LOG_FILE"
    [[ "$target" == "ngrok" ]] && f="$NGROK_LOG"
    if [[ ! -f "$f" ]]; then
        echo "❌ 日志文件不存在: $f" >&2
        exit 1
    fi
    if $follow; then tail -n "$n" -f "$f"; else tail -n "$n" "$f"; fi
}

usage() {
    cat <<EOF
cc-lark — 飞书/Lark Claude Bot 服务控制（macOS .app + 登录项）

用法:
  cc-lark install [--no-login-item]   生成/重写 /Applications/cc-lark.app + 登录项
  cc-lark uninstall                   卸载 (.app + 登录项 + symlink)
  cc-lark start                       启动（open .app）
  cc-lark stop                        停止（TERM wrapper + ngrok 兜底）
  cc-lark restart                     重启
  cc-lark status                      运行状态 + 登录项 + TCC 授权 + bot 日志末尾
  cc-lark logs [bot|ngrok] [-n N] [-f]  查看日志

文件:
  .app        : ${APP_PATH}
  wrapper     : ${WRAPPER_PATH}
  bot   日志  : ${LOG_FILE}
  ngrok 日志  : ${NGROK_LOG}

.env 可配置:
  CALLBACK_PORT   卡片回调端口（默认 9981）
  NGROK_DOMAIN    ngrok 固定域名（不设置则随机域名）

环境变量:
  PYTHON_BIN      覆盖 python3 路径（默认 \$(command -v python3)，pyenv shim 会自动解析为真实解释器）

TCC 注意:
  改 wrapper 后 ad-hoc 签名 cdhash 会变。若 peekaboo 报「不被允许」，
  去「系统设置 → 隐私与安全性」把 cc-lark 从对应权限里删掉再重新加。
EOF
}

case "${1:-}" in
    install|uninstall|start|stop|restart|status|logs)
        cmd="cmd_${1}"; shift
        "$cmd" "$@"
        ;;
    ""|-h|--help|help) usage ;;
    *) echo "❌ 未知命令: $1" >&2; usage; exit 1 ;;
esac
