# ── 多 profile 配置（推荐）────────────────────────────────────
# 每个 profile 是一个独立的 Lark/Feishu bot（不同 app_id、可能不同 tenant、
# 一个走飞书一个走 Lark 都可以）。共用一个进程、一个 ngrok 隧道。
#
# 列出要启动的 profile 名字（逗号分隔）；每个名字对应一套 <NAME>_* 环境变量。
PROFILES=work,personal

# profile: work（举例：Lark 国际版 · larksuite.com）
WORK_PLATFORM=lark                # feishu 或 lark
WORK_APP_ID=cli_xxxxxxxxxxxxxxxx
WORK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WORK_DEFAULT_CWD=/Users/me/projects/work
WORK_ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxx
WORK_ALLOWED_GROUP_CHAT_IDS=oc_xxxxxxxxxxxxxxxx,oc_yyyyyyyyyyyyyyyy
# 告诉 Claude 发 lark-cli 时用哪个 profile（默认 = profile 名）
WORK_LARK_CLI_PROFILE=work
# （可选）派单/会话群：bot 在其它群被 @ 时会把任务派到这个群的新话题里跑。
# 留空 = 禁用派单，bot 在原群直接处理。
# WORK_DISPATCH_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# profile: personal（举例：飞书中国版 · open.feishu.cn）
PERSONAL_PLATFORM=feishu
PERSONAL_APP_ID=cli_yyyyyyyyyyyyyyyy
PERSONAL_APP_SECRET=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
PERSONAL_DEFAULT_CWD=/Users/me/projects/personal
PERSONAL_ALLOWED_OPEN_IDS=ou_yyyyyyyyyyyyyyyy
PERSONAL_ALLOWED_GROUP_CHAT_IDS=oc_zzzzzzzzzzzzzzzz
PERSONAL_LARK_CLI_PROFILE=personal
# PERSONAL_DISPATCH_CHAT_ID=oc_zzzzzzzzzzzzzzzz

# ── 全局共享 ───────────────────────────────────────────────────
DEFAULT_MODEL=claude-sonnet-4-6
PERMISSION_MODE=bypassPermissions
# CALLBACK_PORT=9981
# NGROK_DOMAIN=xxx.ngrok-free.dev

# （可选）Claude CLI 路径，留空则自动从 PATH 查找
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# ── 旧版单 profile 配置（兼容，不推荐）───────────────────────
# 未设置 PROFILES 时退回到这里，自动合成一个名为 "default" 的 profile。
# LARK_PLATFORM=feishu
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEFAULT_CWD=~
# ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxx
# ALLOWED_GROUP_CHAT_IDS=oc_xxxxxxxxxxxxxxxx
