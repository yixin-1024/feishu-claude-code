# ── 多 profile 配置（推荐）────────────────────────────────────
# 每个 profile 是一个独立的 Lark/Feishu bot（不同 app_id、可能不同 tenant、
# 一个走飞书一个走 Lark 都可以）。共用一个进程、一个 ngrok 隧道。
#
# 列出要启动的 profile 名字（逗号分隔）；每个名字对应一套 <NAME>_* 环境变量。
PROFILES=work,personal

# ── 卡片渲染模式（LARK_CARD_MODE，缺省=v2）──────────────────────
# 统一开关，对所有 profile 生效。三选一：
#   v2       默认。Card JSON 2.0 + PATCH 整卡更新，最稳。
#   v1       Card JSON v1 降级兜底。Lark 2.0 渲染故障（报 230099）时临时顶着。
#   cardkit  CardKit 流式卡，客户端打字机 + 增量推送更顺滑；失败自动回退 PATCH/文本/outbox。
# 兼容：未设时回退旧开关 LARK_CARD_STREAMING=1→cardkit、LARK_CARD_SCHEMA=1.0→v1。
# LARK_CARD_MODE=v2

# profile: work（举例：Lark 国际版 · larksuite.com）
WORK_PLATFORM=lark                # feishu 或 lark
WORK_APP_ID=cli_xxxxxxxxxxxxxxxx
WORK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WORK_DEFAULT_CWD=/Users/me/projects/work
WORK_ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxx
WORK_ALLOWED_GROUP_CHAT_IDS=oc_xxxxxxxxxxxxxxxx,oc_yyyyyyyyyyyyyyyy
# Webhook 模式强烈建议填写开放平台「加密策略」中的 Verification Token。
# 使用长连接接收卡片回调时可留空（SDK 已完成来源鉴权）。
# WORK_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# 告诉 Claude 发 lark-cli 时用哪个 profile（默认 = profile 名）
WORK_LARK_CLI_PROFILE=work
# （可选）派单/会话群：bot 在其它群被 @ 时会把任务派到这个群的新话题里跑。
# 留空 = 禁用派单，bot 在原群直接处理。
# WORK_DISPATCH_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# profile: personal（举例：飞书中国版 · open.feishu.cn）
PERSONAL_PLATFORM=feishu
PERSONAL_APP_ID=cli_yyyyyyyyyyyyyyyy
PERSONAL_APP_SECRET=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
PERSONAL_DEFAULT_CWD=/Users/me/projects/personal
PERSONAL_ALLOWED_OPEN_IDS=ou_yyyyyyyyyyyyyyyy
PERSONAL_ALLOWED_GROUP_CHAT_IDS=oc_zzzzzzzzzzzzzzzz
PERSONAL_LARK_CLI_PROFILE=personal
# PERSONAL_DISPATCH_CHAT_ID=oc_zzzzzzzzzzzzzzzz

# ── 全局共享 ───────────────────────────────────────────────────
DEFAULT_MODEL=opus[1m]                   # CLI 别名=系列最新（opus/sonnet/haiku/fable，+[1m] 走 1M 上下文）
RUNNER=claude                         # 默认后端：claude / codex / opencode / mimo
# <PROFILE>_DISPATCH_MODEL —— dispatch_task 派出的子会话默认模型（空=沿用 DEFAULT_MODEL）。
# 典型用法：主对话用便宜/快的模型聊天，派出去干活的子 agent 用最强的模型，例如
#   SPX_DEFAULT_MODEL=fable[1m]
#   SPX_DISPATCH_MODEL=opus[1m]
# ⚠️ 按 profile 单独设、别设全局：模型串必须是该 profile runner 认识的
#   （codex/opencode/mimo profile 继承到 Claude 的 opus[1m] 会直接报错）。
PERMISSION_MODE=bypassPermissions
# CALLBACK_PORT=9981
# CONTROL_PORT=9982                     # 仅绑定 127.0.0.1，绝不能被 ngrok/反代暴露
# CC_LARK_CONTROL_TOKEN=                # 可选固定 token；留空自动生成到 ~/.feishu-claude/control-token (0600)
# NGROK_DOMAIN=xxx.ngrok-free.dev

# ── 全局并发闸门（跨所有 profile / 群 / 话题的整机上限）─────────────────────
# 同时真正在跑的任务数上限；超额的任务 FIFO 排队（卡片显示「排队中」，不丢不拒），
# 腾出额度自动开跑。0 = 不限。别设 1 —— 编排 agent 同一轮里派子会话又等结果会锁死。
# 服务器（小机器 / 共享 API 额度）建议 4；本机开发想放开就写个大数（如 100）。
# CC_LARK_MAX_CONCURRENT_RUNS=4
# 排队最长等待秒数，超时放弃本次任务并在卡片上说明；0 = 一直等（默认，保证不丢活）。
# CC_LARK_QUEUE_MAX_WAIT_SEC=0

# （可选）Claude CLI 路径，留空则自动从 PATH 查找
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# （可选）Claude Code 子后端。全局 CLAUDE_RUNNER 影响所有 claude profile；
# <PROFILE>_CLAUDE_RUNNER 只影响单个 profile。pty=交互式 JSONL tail；
# print=claude --print stream-json，适合绕开某些 Claude Code 版本的 PTY JSONL 兼容问题。
# CLAUDE_RUNNER=pty
# WORK_CLAUDE_RUNNER=print

# （可选）Claude 单轮 wall-clock 上限（秒）。不管还在不在正常产出，跑满就强杀，
# 纯粹防 runaway loop；真正的卡死判定另有 IDLE_TIMEOUT(300s) / STUCK_CHILD(900s) /
# watchdog 三层在管。默认 3600（60 分钟）。
#   0    = 永不因 wall-clock 强杀（长任务推荐；代价是 /compact 这类内置 slash 卡死
#          时没有兜底，只能 /stop 手动收）
#   7200 = 2 小时
# 全局 CLAUDE_WALL_CLOCK_LIMIT_SEC 影响所有 claude profile；<PROFILE>_ 前缀只影响单个。
# CLAUDE_WALL_CLOCK_LIMIT_SEC=0
# SPX_CLAUDE_WALL_CLOCK_LIMIT_SEC=7200

# （可选）上游中断自动续跑次数。上游把流掐断（"Response stalled mid-stream" /
# "Connection closed mid-response" / 5xx / CLI 进程炸）时，bot 会 resume 同一个
# session 自动接着跑，冷却 10s→30s→60s 递增。0 = 关掉自动续跑（出错直接报错卡）。
# CC_LARK_STALL_RETRY_MAX=3
# （可选）写操作标记（逗号分隔）：命中的轮次不做 hung 重试，上游中断续跑时也会换成
# 「先核实上一步是否已生效再继续」的提示，避免重复开户 / 发卡 / 部署这类副作用。
# CC_LARK_WRITE_OP_MARKERS=oneClickOpen,oneClickIssue,deploy-prod
# （可选）模型 safeguards 拦截时的降级模型。Fable 5 的 safeguards 拦截
# （"...safeguards flagged this message... change your model"）同模型重试必然
# 复现，bot 不重试、直接把本对话模型切到该降级模型 resume 续跑并显式通知用户。
# 支持 /model 同款别名。默认 opus[1m]。
# CC_LARK_SAFEGUARDS_FALLBACK_MODEL=opus

# （可选）Codex 后端配置。profile 级覆盖写法：
# GANHUODE_RUNNER=codex
# GANHUODE_DEFAULT_MODEL=gpt-5.1-codex-max
# GANHUODE_CODEX_BIN=/Applications/Codex.app/Contents/Resources/codex
# GANHUODE_CODEX_DANGEROUS_BYPASS=2     # 默认 2：完全 bypass，不请求审批
# GANHUODE_CODEX_SANDBOX_MODE=danger-full-access
# GANHUODE_CODEX_APPROVAL_POLICY=never
# GANHUODE_CODEX_IDLE_TIMEOUT_SEC=3600

# （可选）MiMo Code 后端（小米 `mimo` CLI，fork 自 opencode）。走 provider/model 形式。
# 自定义 OpenAI 兼容 provider 配置写在 ~/.config/mimocode/mimocode.json；若同时给定
# MIMO_BASE_URL + MIMO_API_KEY，runner 启动时会幂等地把该 provider 合并进配置。
# 也可不配 .env，直接在 chat 里 `/runner mimo` 临时切换（用全局配置 + opus4.8 默认）。
# SPX_RUNNER=mimo
# SPX_DEFAULT_MODEL=quotio/claude-opus-4-8
# SPX_MIMO_PROVIDER=quotio
# SPX_MIMO_BASE_URL=http://127.0.0.1:8317/v1
# SPX_MIMO_API_KEY=quotio-local-xxxxxxxx
# SPX_MIMO_VARIANT=high                 # 可选推理强度：high / max / minimal
# SPX_MIMO_IDLE_TIMEOUT_SEC=600         # mimo 首轮迁移较慢，默认 600s 无输出窗口

# （可选）Apache Maka (Incubating) 后端（`maka` CLI，npm i -g maka-agent@next）。
# ⚠️ maka run 一次性返回、**没有流式输出**，所以卡片跑完才出正文；也没有工具事件
# 可播报。MAKA_IDLE_TIMEOUT_SEC 是整轮 wall-clock 上限（不是"多久没输出"）。
# 模型连接存在 maka 自己的 workspace（~/Library/Application Support/Maka/workspaces/
# default/connection-catalog.json）。首启 bootstrap 只在连接目录为空时按 env 种连接：
# MAKA_API_KEY/MAKA_BASE_URL 默认注入 DEEPSEEK_API_KEY/DEEPSEEK_BASE_URL，正好把
# OpenAI 兼容中转站接成一条 `env-deepseek` 连接（另有一条免费 `opencode-free`）。
# 也可不配 .env，直接在 chat 里 `/runner maka` 临时切换。
# SPX_RUNNER=maka
# SPX_DEFAULT_MODEL=deepseek-v4-flash
# SPX_MAKA_CONNECTION=env-deepseek       # 空=用 maka 的默认连接
# SPX_MAKA_BASE_URL=https://api.wowapi.ai/v1
# SPX_MAKA_API_KEY=sk-xxxxxxxx
# SPX_MAKA_MAX_STEPS=0                   # >0 给工具步数加护栏
# SPX_MAKA_IDLE_TIMEOUT_SEC=1800         # 整轮 wall-clock 上限（与全局 CLAUDE_WALL_CLOCK_LIMIT_SEC 取小）
# SPX_MAKA_BIN=/opt/homebrew/bin/maka    # 空=PATH 里的 maka
# SPX_MAKA_WORKSPACE_ROOT=              # 空=maka 默认 profile "Maka" 的 default workspace

# ── 旧版单 profile 配置（兼容，不推荐）───────────────────────
# 未设置 PROFILES 时退回到这里，自动合成一个名为 "default" 的 profile。
# LARK_PLATFORM=feishu
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEFAULT_CWD=~
# ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxx
# ALLOWED_GROUP_CHAT_IDS=oc_xxxxxxxxxxxxxxxx


# ═══════════════════════════════════════════════════════════════════
# Trinity 三省体系（5 角色协作模式）
# ═══════════════════════════════════════════════════════════════════
#
# 把"Boss 一句话 → bot 直接执行"重构成 5 个独立 bot 协作：
#
#   下行（5 跳）：Boss → 御史台 → 中书 → 门下 → 尚书 → 干活的
#   上行（4 跳）：干活的 → 尚书 → 门下 → 御史台 → Boss
#   驳回：       门下 → 中书 重拟
#   升级：       御史台 → Boss 补信息
#
# ── 主开关：默认 OFF ─────────────────────────────────────────
#   ENABLE_TRINITY=true   启用 trinity 路径（所有 profile 的 ROLE 字段生效）
#   不设置 / false        所有 profile 走遗留行为，即使配了 ROLE 也忽略
#
# 这样可以**两组配置共存**——在 .env 里把 trinity 5 个 profile + 之前 3 个
# profile 都留着，平时关闭，要测试时打开。
#
# 启用步骤：
#   1. 在 Lark 开发者后台建 5 个独立 app，各拿一组 app_id/app_secret
#   2. 拿到每个 bot 的 open_id（在群里 @ bot 时返回的 id）
#   3. 把 5 个 bot 拉进同一个"朝廷群"
#   4. 复制下面这段到 .env，把 cli_xxx / ou_xxx / oc_xxx 替换成真实值
#   5. 设置 ENABLE_TRINITY=true 并把 PROFILES 改成 5 个角色名
#   6. 重启 bot 进程
# ═══════════════════════════════════════════════════════════════════

# ENABLE_TRINITY=false

# PROFILES=yushitai,zhongshu,menxia,shangshu,ganhuode

# ── 5 个角色共享的 open_id（朝廷群成员，全员可见）─────────────
# BOSS_OPEN_ID=ou_boss_xxxxxxxxxxxxxxxx       # 皇帝本人
# YUSHITAI_OPEN_ID=ou_yushitai_xxxxxxxxxxxxxxxx     # 御史台 bot
# ZHONGSHU_OPEN_ID=ou_zhongshu_xxxxxxxxxxxxxxxx     # 中书 bot
# MENXIA_OPEN_ID=ou_menxia_xxxxxxxxxxxxxxxxxx       # 门下 bot
# SHANGSHU_OPEN_ID=ou_shangshu_xxxxxxxxxxxxxxxx     # 尚书 bot
# GANHUODE_OPEN_ID=ou_ganhuode_xxxxxxxxxxxxxxxx     # 干活的 bot

# ── profile: yushitai（御史台 = 入口 + 终审，与 Boss 唯一对接者）──
# YUSHITAI_PLATFORM=lark
# YUSHITAI_APP_ID=cli_yushitai_xxxxxxxxxxxxxxxx
# YUSHITAI_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# YUSHITAI_ROLE=yushitai
# YUSHITAI_BOT_OPEN_ID=ou_yushitai_xxxxxxxxxxxxxxxx
# YUSHITAI_COURT_CHAT_ID=oc_court_xxxxxxxxxxxxxxxx     # 朝廷群
# YUSHITAI_DEFAULT_CWD=/Users/me/projects/spx
# YUSHITAI_LARK_CLI_PROFILE=yushitai

# ── profile: zhongshu（中书 = 拟令）─────────────────────────────
# ZHONGSHU_PLATFORM=lark
# ZHONGSHU_APP_ID=cli_zhongshu_xxxxxxxxxxxxxxxx
# ZHONGSHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ZHONGSHU_ROLE=zhongshu
# ZHONGSHU_BOT_OPEN_ID=ou_zhongshu_xxxxxxxxxxxxxxxx
# ZHONGSHU_COURT_CHAT_ID=oc_court_xxxxxxxxxxxxxxxx
# ZHONGSHU_DEFAULT_CWD=/Users/me/projects/spx
# ZHONGSHU_LARK_CLI_PROFILE=zhongshu

# ── profile: menxia（门下 = 事前审议 + 事后影子复审）─────────────
# MENXIA_PLATFORM=lark
# MENXIA_APP_ID=cli_menxia_xxxxxxxxxxxxxxxxxx
# MENXIA_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MENXIA_ROLE=menxia
# MENXIA_BOT_OPEN_ID=ou_menxia_xxxxxxxxxxxxxxxxxx
# MENXIA_COURT_CHAT_ID=oc_court_xxxxxxxxxxxxxxxx
# MENXIA_DEFAULT_CWD=/Users/me/projects/spx
# MENXIA_LARK_CLI_PROFILE=menxia

# ── profile: shangshu（尚书 = 派工 + 聚合）──────────────────────
# SHANGSHU_PLATFORM=lark
# SHANGSHU_APP_ID=cli_shangshu_xxxxxxxxxxxxxxxx
# SHANGSHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SHANGSHU_ROLE=shangshu
# SHANGSHU_BOT_OPEN_ID=ou_shangshu_xxxxxxxxxxxxxxxx
# SHANGSHU_COURT_CHAT_ID=oc_court_xxxxxxxxxxxxxxxx
# SHANGSHU_DEFAULT_CWD=/Users/me/projects/spx
# SHANGSHU_LARK_CLI_PROFILE=shangshu

# ── profile: ganhuode（干活的 = 6 部人格内嵌切换）───────────────
# GANHUODE_PLATFORM=lark
# GANHUODE_APP_ID=cli_ganhuode_xxxxxxxxxxxxxxxx
# GANHUODE_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GANHUODE_ROLE=ganhuode
# GANHUODE_BOT_OPEN_ID=ou_ganhuode_xxxxxxxxxxxxxxxx
# GANHUODE_COURT_CHAT_ID=oc_court_xxxxxxxxxxxxxxxx
# GANHUODE_DEFAULT_CWD=/Users/me/projects/spx
# GANHUODE_LARK_CLI_PROFILE=ganhuode

# ── Claude Max 多账户智能切换 ──────────────────────────────────
# 前置：用 `python3 account_switcher.py save <name>`（或 ~/bin/claude-switch shim）
# 把每个账户存到 ~/.claude/accounts/。账户文件 schema v2 同时存 keychain 凭证 +
# ~/.claude.json identity（oauthAccount/userID），切账户时一起搬，避免 CLI 启动
# 检测身份不一致触发 re-login 回滚 keychain。
# 启用后 cc-lark 每次 quota poll 都会探测所有账户、按 5h+7d headroom 打分，
# 必要时自动 use_account 切到更优账户。
# ACCOUNT_AUTO_SWITCH=1
# ACCOUNT_SWITCH_COOLDOWN_SEC=1800
# QUOTA_WATCH_INTERVAL_SEC=600
# 撞用量墙时的一次性紧急切换（与上面的主动切换独立，AUTO_SWITCH=0 也生效，默认开）：
# 某轮 claude 在 API 上撞 "You've hit your session limit" → 探测所有 saved 账户，切到
# 最有余量的那个并 resume 同一 session 续跑；没有可切的账户 → 在本话题排一个到配额
# 重置时刻的自动唤醒（CC_LARK_WAKE_ON_LIMIT，仅话题群可用），醒来自动『继续』。
# ACCOUNT_SWITCH_ON_LIMIT=1
# CC_LARK_WAKE_ON_LIMIT=1

# ── codex：模型被当前账户拒绝时的 fallback ─────────────────────
# ChatGPT 账户下 gpt-5.6-sol 会间歇性回 400 "model is not supported when using Codex with
# a ChatGPT account"。命中时本轮自动改用 fallback 模型原样重发（不粘住，下一轮仍按原
# 模型试）。空串 = 关闭。
# CODEX_MODEL_FALLBACK=gpt-5.5

# ── bot 日志轮转（copytruncate，进程内完成，不需要 newsyslog）──────
# cc-lark.app 启动器把 stdout 追加到 ~/.feishu-claude/cc-lark.log；超过阈值就复制到
# .1 并清空原文件，保留 N 代。0 = 关闭。
# CC_LARK_LOG_PATH=~/.feishu-claude/cc-lark.log
# CC_LARK_LOG_MAX_MB=50
# CC_LARK_LOG_KEEP=3

# ── 定时任务的用量刹车线 ───────────────────────────────────────
# scheduler 每次 cron fire 前先探 quota：任一窗口用量 >= 刹车线就跳过本轮，
# 只在群里发一条"⏸️ 跳过本轮"，不派单。意思是"定时任务最多吃到这条线，
# 剩下的留给人工交互"，不是等真耗尽才停。写 0.95 或 95 都认。
# 默认：5h=0.95 / 7d=0.97
# SCHED_QUOTA_SKIP_5H=0.95
# SCHED_QUOTA_SKIP_7D=0.97

# ── 外部事件触发 API（详见 external_triggers.yaml.example / README）─────
# 后端服务用 HTTP 把活派进 Lark 群：POST /api/v1/agent-tasks
#   Authorization: Bearer <client_id>:<secret>
# 每个 client 一把密钥，名字对应 yaml 里的 secret_env；<16 字符不启用（fail-closed）。
# CC_LARK_API_SECRET_SPX_BACKEND=$(openssl rand -hex 32)
# 顶楼 @ 谁（会话归属人）。任务落到哪个群是**每条 route 各自的 chat_id**，写在
# external_triggers.yaml 里 —— 一个 workspace 配它自己的群，不要多个 workspace 共用。
# CC_LARK_EVENT_OWNER_OPEN_ID=ou_xxxxxxxxxxxxxxxx
# 走反代时才需要：可信反代 IP（决定是否认 X-Forwarded-For）
# CC_LARK_API_TRUSTED_PROXY_IPS=127.0.0.1
# 可选上限（默认值即可）：单条提示词字符数 / 幂等键保留时长 / 派发等待超时
# CC_LARK_API_MAX_PROMPT_CHARS=20000
# CC_LARK_API_IDEMPOTENCY_TTL_SEC=21600
# CC_LARK_API_DISPATCH_TIMEOUT_SEC=45
