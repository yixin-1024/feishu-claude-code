# 平台选择：feishu（中国版，默认）或 lark（国际版 larksuite.com）
LARK_PLATFORM=feishu

# 应用凭证
#   - 飞书：https://open.feishu.cn/app
#   - Lark：https://open.larksuite.com/app
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude 默认配置
DEFAULT_MODEL=claude-sonnet-4-6
DEFAULT_CWD=~

# 工具权限模式：bypassPermissions（跳过所有确认，推荐个人使用）
#              default（需要确认敏感操作）
PERMISSION_MODE=bypassPermissions

# 访问控制
# ALLOWED_OPEN_IDS: 允许使用 bot 的用户 open_id，逗号分隔。为空则不限制（不推荐）。
#   查自己的 open_id 方法：首次私聊 bot，终端日志里会打印 "user=ou_xxxxxxxx..."
ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxx,ou_yyyyyyyyyyyyyyyy
# ALLOWED_GROUP_CHAT_IDS: 群聊白名单（逗号分隔的 chat_id，oc_ 开头）
#   为空 → 禁用所有群聊；列出的群里 @bot 才会响应。
#   查群 chat_id 方法：bot 入群后发条 @bot 消息，终端日志里会打印 "chat=oc_xxxxxxxx..."
# ALLOWED_GROUP_CHAT_IDS=oc_xxxxxxxxxxxxxxxx,oc_yyyyyyyyyyyyyyyy

# ngrok 固定域名（可选，ngrok-free 也支持一个固定域名）
# 配上这个：cc-lark 会用 `ngrok http --url <域名> 9981` 启动，重启 URL 不变
# 不配置：每次重启随机域名，要到 Lark 开放平台手动改卡片回调 URL
# NGROK_DOMAIN=xxx.ngrok-free.dev
#
# CALLBACK_PORT: 卡片回调 HTTP 端口（默认 9981）
# CALLBACK_PORT=9981

# （可选）Claude CLI 路径，留空则自动从 PATH 查找
# CLAUDE_CLI_PATH=/usr/local/bin/claude
