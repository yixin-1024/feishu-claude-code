.env
.env.test
.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.DS_Store
*.log

# Playwright MCP 缓存（自动生成的浏览器 session 日志 / snapshot）
.playwright-mcp/

# 本地运行时数据（inbox watcher 等模块的 sqlite + 媒体）—— 含敏感聊天历史，不进 git
store/

# 本地业务配置（含 chat_id / 个人路径），按 .example 模板自行创建
scheduled_tasks.yaml

# prompts/ 整体忽略（用户私有 cron prompt），但系统级模板要进版本控制。
# 注意：用 prompts/* 而非 prompts/，否则 negate 对子文件不生效。
prompts/*
!prompts/default.md
!prompts/_dispatch.md
!prompts/yushitai.md
!prompts/zhongshu.md
!prompts/menxia.md
!prompts/shangshu.md
!prompts/ganhuode.md
# spx_*.md 是 reflection 任务渐进演化的产物，进版本控制以保留 patch 历史。
# verify.md 是通用验证模板。
# cc_lark_prompt_reflection.md 是 meta-prompt，也要 tracked（反思任务本身的演化）。
!prompts/spx_*.md
!prompts/verify.md
!prompts/cc_lark_prompt_reflection.md
# 但 .bak.<TS> 仍然忽略（应急快速回滚快照，不该污染历史）
prompts/*.bak.*
