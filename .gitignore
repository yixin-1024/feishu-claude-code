.env
.env.test
.env.deepseek
# 任何 .env.<provider> 覆盖文件都含密钥，统一忽略（保留 .env.example）
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.DS_Store
*.log

# Playwright MCP 缓存（自动生成的浏览器 session 日志 / snapshot）
.playwright-mcp/

# 本地运行时数据（inbox watcher 等模块的 sqlite + 媒体）—— 含敏感聊天历史，不进 git
store/

# 本地业务配置（含 chat_id / 个人路径），按 .example 模板自行创建
scheduled_tasks.yaml
inbox_config.yaml

# 私有规划目录（GSD 等），不进版本控制
.planning/

# 本地运行时产物 / 工作区（不进 git）：
# data/ = agent 创建的 cron prompt 等运行时落盘；output/ = 会话产物；
# tmp/ = 临时工作区；papers/ = 论文工作区（大体积，独立于 bot 功能）；
# logs/ = 发送失败重投 outbox 等运行时日志（含 chat_id / 会话内容）
data/
output/
tmp/
papers/
logs/

# prompts/ 整体忽略（用户私有 cron / 角色 prompt，含真实路径/域名/人名），
# 只有通用框架模板进版本控制。注意用 prompts/* 而非 prompts/，否则 negate 不生效。
prompts/*
!prompts/default.md
!prompts/_dispatch.md
!prompts/verify.md
!prompts/_runtime_mcp_claude.md
!prompts/_runtime_mcp_other.md
# 但 .bak.<TS> 仍然忽略（应急快速回滚快照，不该污染历史）
prompts/*.bak.*
